{
  "name": "@epodivilov/vikunja-mcp",
  "mcpName": "io.github.epodivilov/vikunja-mcp",
  "version": "0.1.0",
  "description": "Lean, identifier-native MCP server for Vikunja: compact task payloads and project keys like INFRA-41 instead of opaque global IDs.",
  "type": "module",
  "license": "MIT",
  "author": "Evgenii Podivilov",
  "homepage": "https://github.com/epodivilov/vikunja-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epodivilov/vikunja-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/epodivilov/vikunja-mcp/issues"
  },
  "keywords": [
    "vikunja",
    "mcp",
    "model-context-protocol",
    "tasks",
    "todo",
    "productivity"
  ],
  "bin": {
    "vikunja-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset:version": "changeset version && npm run format",
    "test": "node --test test/*.test.ts",
    "check": "biome check . && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^18.0.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.4",
    "@types/turndown": "^5.0.5",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@biomejs/biome@2.5.14": true
  }
}
